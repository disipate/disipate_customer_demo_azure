# Disipate Azure Customer Demo Collector - environment template
# Copy to .env and fill in. .env is gitignored.

# Disipate-provided SAS URL for the demo blob container.
# Scope: srt=co (create+write), sp=cw, se=24h, single container.
# DISIPATE_SAS_URL=https://<account>.blob.core.windows.net/<container>?<sas-query>

# Optional: override the public repo URL for install_cloudshell.sh
# DISIPATE_REPO_URL=https://github.com/disipate/disipate_customer_demo_azure.git

# Optional: pin a specific scope (else: derive from current RG context)
# DEMO_SCOPE=subscriptions/<sub-id>/resourceGroups/<rg-name>
